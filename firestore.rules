rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "admin@abada.app" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // Admin allow-list: one doc per admin, with the admin's email as the document id. Managed
    // in the Firebase console only. A signed-in user may read only their own entry, so the
    // list of admins can't be enumerated.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }

    match /song_overrides/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /songs_extra/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /toque_patterns/{toqueId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
